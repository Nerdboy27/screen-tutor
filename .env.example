# Backend (prefix TUTOR_)
TUTOR_GEMINI_API_KEY=
TUTOR_GEMINI_MODEL=gemini-1.5-flash
TUTOR_ENVIRONMENT=development
TUTOR_DATABASE_URL=sqlite+aiosqlite:///./tutor.db
# Comma separated client keys. Leave empty to disable auth (development only).
TUTOR_API_KEYS=
TUTOR_CORS_ORIGINS=http://localhost:3000
TUTOR_VISUAL_CONTEXT_TTL_SECONDS=900
TUTOR_MAX_IMAGE_BYTES=12582912

# Desktop client
TUTOR_API_BASE_URL=http://127.0.0.1:8000
TUTOR_API_KEY=
TUTOR_HOTKEY=<ctrl>+<shift>+<space>

# Web dashboard
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_KEY=
